{
  "name": "@groton/veracross-birthdays",
  "version": "1.0.0",
  "description": "Configurable birthday calendar feed for Veracross",
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "email": "sbattis@groton.org"
  },
  "type": "module",
  "scripts": {
    "clean": "del ./build",
    "setup": "run-s setup:*",
    "setup:prettier": "setup-prettier -f",
    "setup:eslint": "setup-eslint -f",
    "setup:commit": "setup-eslint -f",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:compile": "tsc",
    "deploy": "run-s deploy:*",
    "deploy:build": "run-s build",
    "deploy:deploy": "./scripts/deploy -v",
    "gcp-build": "echo \"Pre-compiled TypeScript\"",
    "start": "node ./build/index.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "@oauth2-cli/veracross": "^0.2.3",
    "express": "^5.2.1",
    "ics": "^3.12.0",
    "luxon": "^3.7.2",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.8.4"
  },
  "devDependencies": {
    "@1password/sdk": "^0.4.0",
    "@battis/commit": "^0.0.7",
    "@battis/eslint": "^3.0.6",
    "@battis/partly-gcloudy": "^3.4.5",
    "@battis/prettier": "^2.0.10",
    "@battis/typescript-tricks": "^0.8.5",
    "@inquirer/input": "^5.1.2",
    "@qui-cli/colors": "^3.2.4",
    "@qui-cli/core": "^7.0.0",
    "@qui-cli/env": "^5.2.0",
    "@qui-cli/log": "^4.0.4",
    "@qui-cli/validators": "^3.0.5",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.13.3",
    "commit-and-tag-version": "^13.1.0",
    "del-cli": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  }
}
